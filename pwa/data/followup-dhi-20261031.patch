+// RetryDKVSSync wakes the existing worker for an immediate synchronization attempt.
+func (p *Manager) RetryDKVSSync() error {
+	if err := p.StartDKVSSync(); err != nil {
+		return err
+	}
+	p.dkvsInitMu.Lock()
+	manager := p.dkvs
+	p.dkvsInitMu.Unlock()
+	if manager == nil {
+		return ErrDKVSPathNotSynced
+	}
+	manager.wakeSync()
+	return nil
+}
